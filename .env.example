# ─── Web (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── API (Django) ────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-real-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — set either DATABASE_URL or individual PG* vars
DATABASE_URL=postgres://omnia:omnia@localhost:5432/omnia
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=omnia
# PGUSER=omnia
# PGPASSWORD=omnia

# ─── SVC (FastAPI) ───────────────────────────────────────────
SVC_INTERNAL_TOKEN=change-me-internal-secret
SVC_HOST=127.0.0.1
SVC_PORT=8001

# Whisper STT model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=small

# OSRM routing service
OSRM_BASE_URL=https://router.project-osrm.org

# OCR (EasyOCR)
OCR_USE_GPU=false

# ─── Email ──────────────────────────────────────────────────
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@omnia.org

# ─── SMS Gateway ────────────────────────────────────────────
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
